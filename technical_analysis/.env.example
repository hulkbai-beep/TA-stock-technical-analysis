# Copy to .env in this directory. Never commit the real .env.
FMP_API_KEY=your_fmp_api_key
# Official FMP: query authentication (default). Existing compatible gateways
# may use FMP_BASE_URL=https://your-gateway and FMP_AUTH_MODE=proxy (X-Proxy-Key).
# FMP_BASE_URL=https://financialmodelingprep.com
# FMP_AUTH_MODE=query
